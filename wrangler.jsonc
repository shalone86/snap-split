{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "snap-split",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "ai": { "binding": "AI" },
  // Shared Angelio store: family codes and daily safety caps (worker/codes.js).
  "kv_namespaces": [{ "binding": "CODES", "id": "a39d9bda676b420394c3eaba35975dec" }],
  "observability": { "enabled": true },
  // Lives at angelio.org through the hub. The old address redirects there with saved progress (worker/moved.js).
  "vars": { "HOME_URL": "https://angelio.org/snap/", "STORE_KEY": "snapsplit:v1" },
  "workers_dev": true,
  "routes": [{ "pattern": "snap.shalonely.com", "custom_domain": true }]
  //
  // Optional: require a passcode for the voice API (keeps strangers off your Workers AI quota):
  //   npx wrangler secret put APP_PASSCODE
}
